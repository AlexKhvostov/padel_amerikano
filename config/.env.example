# Скопируйте в .env в корне проекта

APP_URL=https://padel.ballaball.xyz
APP_ENV=production
APP_DEBUG=false
# IP доверенных reverse proxy через запятую; обычно оставляется пустым
TRUSTED_PROXIES=

# Hostland MySQL 8.0 (хост и порт раздельно)
DB_HOST=mysql80.hostland.ru
DB_PORT=3308
DB_NAME=host1708875_padelbd
DB_USER=host1708875_upadel
DB_PASSWORD=

# Случайная строка не короче 32 символов для подписи токенов сессии
APP_SECRET=

# Отправитель писем (напоминание кода администратора)
# На Hostland php mail() часто «успешен», но письмо не доходит.
# Надёжный способ: создать ящик в панели Hostland и отправлять через SMTP.
MAIL_FROM=admin@padel.ballaball.xyz
MAIL_FROM_NAME=Падел Американо
MAIL_SMTP_HOST=mail.hostland.ru
MAIL_SMTP_PORT=465
MAIL_SMTP_ENCRYPTION=ssl
MAIL_SMTP_USER=admin@padel.ballaball.xyz
MAIL_SMTP_PASSWORD=
